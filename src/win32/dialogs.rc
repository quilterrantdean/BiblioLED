1 24 "app.manifest"

#include <windows.h>
#include "resource.h"

IDI_BIBLIOLED ICON "../../port.ico"

IDD_LOAN_DIALOG DIALOG 0, 0, 258, 126
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Empréstimo"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT       "Título:", -1, 8, 10, 40, 10
    EDITTEXT    IDC_LOAN_TITLE, 54, 8, 196, 14, ES_AUTOHSCROLL

    LTEXT       "Tipo:", -1, 8, 31, 40, 10
    COMBOBOX    IDC_LOAN_TYPE, 54, 29, 112, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT       "Data (AAAA-MM-DD):", -1, 8, 53, 85, 10
    EDITTEXT    IDC_LOAN_DATE, 96, 51, 75, 14, ES_AUTOHSCROLL

    LTEXT       "Hora (HH:MM):", -1, 8, 75, 85, 10
    EDITTEXT    IDC_LOAN_TIME, 96, 73, 55, 14, ES_AUTOHSCROLL

    DEFPUSHBUTTON "Guardar", IDOK, 142, 101, 52, 16
    PUSHBUTTON    "Cancelar", IDCANCEL, 198, 101, 52, 16
END

IDD_BACKUP_SETTINGS_DIALOG DIALOG 0, 0, 230, 104
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Definições de cópias de segurança"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT       "Formato de compressão:", -1, 8, 12, 90, 10
    COMBOBOX    IDC_BACKUP_FORMAT, 104, 9, 118, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT       "Nível (0–9):", -1, 8, 36, 90, 10
    COMBOBOX    IDC_BACKUP_LEVEL, 104, 33, 54, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    DEFPUSHBUTTON "Guardar", IDOK, 114, 78, 52, 16
    PUSHBUTTON    "Cancelar", IDCANCEL, 170, 78, 52, 16
END
